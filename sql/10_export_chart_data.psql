-- Выполнять из корня репозитория после расчётных файлов 00–08.
-- Сначала создать локальную папку outputs/chart_data.
-- Выгрузки исключены из Git. Каждая команда \copy занимает одну строку.
\set ON_ERROR_STOP on
\copy (SELECT p.short_name AS university, c.ege_fixed_gap AS score_gap, c.groups_used FROM research.comparison_changes c JOIN research.pilot_universities p USING (university) WHERE c.scope = 'whole' AND c.metric = 'score' AND c.base_year = 2022 AND c.end_year = 2025 ORDER BY p.short_name) TO 'outputs/chart_data/score_changes.csv' WITH (FORMAT CSV, HEADER TRUE, ENCODING 'UTF8')
\copy (SELECT p.short_name AS university, c.growth_pct, c.reference_growth_pct, c.groups_used FROM research.comparison_changes c JOIN research.pilot_universities p USING (university) WHERE c.scope = 'cohort2023' AND c.side = 'linked' AND c.metric = 'score' AND c.base_year = 2022 AND c.end_year = 2025 ORDER BY p.short_name) TO 'outputs/chart_data/intake_growth.csv' WITH (FORMAT CSV, HEADER TRUE, ENCODING 'UTF8')
\copy (SELECT p.short_name AS university, c.bvi0, c.bvi1, c.n0, c.n1, c.bvi_share_gap_pp AS share_gap, c.groups_used FROM research.comparison_changes c JOIN research.pilot_universities p USING (university) WHERE c.scope = 'cohort2023' AND c.side = 'linked' AND c.metric = 'bvi' AND c.base_year = 2022 AND c.end_year = 2025 ORDER BY p.short_name) TO 'outputs/chart_data/bvi_changes.csv' WITH (FORMAT CSV, HEADER TRUE, ENCODING 'UTF8')
\copy (SELECT json_object_agg(label, counts) FROM (SELECT CASE WHEN scope='whole' THEN 'score' WHEN metric='bvi' THEN 'bvi' ELSE 'intake' END AS label, json_build_object('groups',SUM(groups_used),'universities',COUNT(*)) AS counts FROM research.comparison_changes WHERE base_year=2022 AND end_year=2025 AND ((scope='whole' AND metric='score') OR (scope='cohort2023' AND side='linked' AND metric IN ('score','bvi'))) GROUP BY scope,metric) s) TO 'outputs/chart_data/panel_metadata.json' WITH (FORMAT text, ENCODING 'UTF8')
